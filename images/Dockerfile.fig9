# Figure 9 only. A different Ray Data build from every other figure.
#
#   docker build -f images/Dockerfile.fig9 -t raydata-fig9:nsdi27 .
#
# Needs branch nsdi27-fig9 on ray-data-eval/ray to be pushed.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3-pip git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
ENV VIRTUAL_ENV=/opt/raydata-fig9
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

WORKDIR /artifact
COPY env/ env/
RUN pip install --no-cache-dir -r env/requirements.txt

COPY . .
RUN bash scripts/setup/install_ray_data_fig9.sh

CMD ["/bin/bash"]
