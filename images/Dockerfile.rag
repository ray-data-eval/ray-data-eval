# Figure 7a only. vLLM pins an older Ray, so Ray Data is installed separately.
#
#   docker build -f images/Dockerfile.rag -t raydata-rag:nsdi27 .
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3-pip git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
ENV VIRTUAL_ENV=/opt/raydata-rag
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

WORKDIR /artifact
COPY env/ env/
RUN pip install --no-cache-dir -r env/requirements-rag.txt \
    && pip install --no-cache-dir "ray[data]==2.44.1"

COPY . .

# The knowledge base and Llama-3-8B are not baked in: TriviaQA is downloaded by
# the reviewer, and the model is gated on Hugging Face.
CMD ["/bin/bash"]
