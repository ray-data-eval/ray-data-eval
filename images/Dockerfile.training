# Figure 8a: ResNet-50 training and its tf.data baseline.
#
#   docker build -f images/Dockerfile.training -t raydata-training:nsdi27 .
#
# Separate from the video image because TensorFlow 2.16.1 pins numpy<2.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3-pip git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
ENV VIRTUAL_ENV=/opt/raydata-training
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

WORKDIR /artifact
COPY env/ env/
RUN pip install --no-cache-dir -r env/requirements-training.txt

COPY . .
RUN bash scripts/setup/install_ray_data.sh

ENV RAY_DEDUP_LOGS=0
CMD ["/bin/bash"]
